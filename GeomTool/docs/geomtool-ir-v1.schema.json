{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/geomtool/geomtool-ir-v1.schema.json",
  "title": "GeomTool Geometry IR v1",
  "type": "object",
  "required": [
    "schema",
    "nodes"
  ],
  "properties": {
    "schema": {
      "const": "geomtool.ir/v1"
    },
    "protocol": {
      "type": "string"
    },
    "nodes": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "op",
          "inputs",
          "params"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "label": {
            "type": "string",
            "maxLength": 32
          },
          "op": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "params": {
            "type": "object"
          },
          "style": {
            "type": "object",
            "properties": {
              "visible": {
                "type": "boolean"
              },
              "dashed": {
                "type": "boolean"
              },
              "color": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}